<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /carmen-frontend/
  
  # If the requested file or directory exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite legacy / dynamic /rencana-menu/<id> to detail/?id=<id>
  RewriteRule ^rencana-menu/([0-9]+)/?$ rencana-menu/detail/?id=$1 [QSA,L]

  # Fallback to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>
