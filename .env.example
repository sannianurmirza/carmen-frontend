# CARMEN Next.js Frontend Production Environment Configuration Example
# Copy this file to .env.production on the Windows Server

# Subpath under Apache VirtualHost (default: /catering-ir/public)
NEXT_PUBLIC_BASE_PATH=/catering-ir/public

# Public API prefix routed via Apache reverse proxy
NEXT_PUBLIC_API_URL=/catering-ir/api

# Internal backend target for Next.js server-side rewrites (if applicable)
BACKEND_API_TARGET=http://127.0.0.1:80

# Next.js Node server port
PORT=3000
NODE_ENV=production
